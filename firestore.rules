rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // users
    match /users/{userId} {
      // 読み取り: 本人のみ
      allow read: if isOwner(userId) || isAdmin();

      // 作成: 本人のみ（初回登録時）
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'createdAt', 'isAnonymous', 'authProviders'])
        && request.resource.data.isAnonymous is bool
        && request.resource.data.authProviders is list;

      // 更新: 本人のみ（特定フィールドのみ変更可能）
      // totalPoints, totalBookings, totalGachaPlaysはCloud Functionsのみが変更可能
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['uid', 'createdAt', 'totalPoints', 'totalBookings', 'totalGachaPlays']);

      // 削除: 禁止（論理削除のみ）
      allow delete: if false;
    }

    // users/{userId}/vehicles/{vehicleId}
    match /users/{userId}/vehicles/{vehicleId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
          ['make','model','year','vin','plate','color','notes','createdAt','updatedAt','createdBy','updatedBy'])
        && request.resource.data.make is string
        && request.resource.data.model is string
        && request.resource.data.year is number
        && (!('vin' in request.resource.data) || request.resource.data.vin is string)
        && (!('plate' in request.resource.data) || request.resource.data.plate is string)
        && (!('color' in request.resource.data) || request.resource.data.color is string)
        && (!('notes' in request.resource.data) || request.resource.data.notes is string)
        && request.resource.data.createdAt is timestamp
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt','createdBy','updatedBy'])
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(
          ['make','model','year','vin','plate','color','notes','updatedAt'])
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false; // 物理削除禁止（論理削除フラグで運用）

      // serviceHistory（店舗/Functionsのみ書込）
      match /serviceHistory/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // 店舗/Functionsのみ書込
      }

      // warranties（店舗/Functionsのみ書込）
      match /warranties/{warrantyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // 店舗/Functionsのみ書込
      }
    }

    // bookings（トップレベル）
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // 予約作成/取消は Functions のみ
    }

    // gachaClaims（Cloud Functionsのみが書込可能）
    match /users/{userId}/gachaClaims/{yyyymmdd} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functionsのみ
    }

    // points（Cloud Functionsのみが書込可能）
    match /users/{userId}/points {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functionsのみ
    }

    // pointLedger（Cloud Functionsのみが書込可能）
    match /users/{userId}/pointLedger/{entryId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functionsのみ
    }

    // stats（月次統計、Cloud Functionsのみが書込可能）
    match /users/{userId}/stats/{yyyymm} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functionsのみ
    }

    // coupons（Cloud Functionsのみが書込可能）
    match /users/{userId}/coupons/{couponId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // redeemはCallableで処理
    }

    // couponTemplates（公開読取、Functionsのみ書込）
    match /couponTemplates/{templateId} {
      allow read: if true; // 全ユーザーが読取可能（テンプレート情報）
      allow write: if false; // Cloud Functionsのみ
    }

    // serviceCenters（スロット管理、Cloud Functionsのみ書込）
    match /serviceCenters/{centerId}/days/{yyyymmdd}/slots/{slotId} {
      allow read: if isSignedIn(); // 全ログインユーザーが読取可能
      allow write: if false; // Cloud Functionsのみ
    }

    // serviceCenters settings（管理者のみアクセス）
    match /serviceCenters/{centerId}/settings {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
