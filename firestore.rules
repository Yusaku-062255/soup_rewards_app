rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // users
    match /users/{userId} {
      // 読み取り: 本人のみ
      allow read: if isOwner(userId) || isAdmin();

      // 作成: 本人のみ（初回登録時）
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'createdAt', 'isAnonymous', 'authProviders'])
        && request.resource.data.isAnonymous is bool
        && request.resource.data.authProviders is list;

      // 更新: 本人のみ（特定フィールドのみ変更可能）
      // totalPoints, totalBookings, totalGachaPlaysはCloud Functionsのみが変更可能
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['uid', 'createdAt', 'totalPoints', 'totalBookings', 'totalGachaPlays']);

      // 削除: 禁止（論理削除のみ）
      allow delete: if false;
    }

    // users/{userId}/vehicles/{vehicleId}
    match /users/{userId}/vehicles/{vehicleId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
          ['make','model','year','vin','nickname','createdAt','updatedAt'])
        && request.resource.data.make is string
        && request.resource.data.model is string
        && request.resource.data.year is number
        && (!('vin' in request.resource.data) || request.resource.data.vin is string)
        && (!('nickname' in request.resource.data) || request.resource.data.nickname is string)
        && request.resource.data.createdAt is timestamp
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow update: if isOwner(userId) || isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(
          ['make','model','year','vin','nickname','updatedAt'])
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId) || isAdmin();

      // serviceHistory
      match /serviceHistory/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(
            ['serviceAt','odometer','items','note','shop','createdAt','updatedAt'])
          && request.resource.data.serviceAt is timestamp
          && (!('odometer' in request.resource.data) || request.resource.data.odometer is number)
          && (!('items' in request.resource.data) || request.resource.data.items is list)
          && (!('note' in request.resource.data) || request.resource.data.note is string)
          && (!('shop' in request.resource.data) || request.resource.data.shop is string)
          && request.resource.data.createdAt is timestamp
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
        allow update: if isOwner(userId) || isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(
            ['serviceAt','odometer','items','note','shop','updatedAt'])
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // warranties
      match /warranties/{warrantyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(
            ['provider','policyNumber','startAt','endAt','coverage','createdAt','updatedAt'])
          && request.resource.data.provider is string
          && (!('policyNumber' in request.resource.data) || request.resource.data.policyNumber is string)
          && request.resource.data.startAt is timestamp
          && request.resource.data.endAt is timestamp
          && request.resource.data.endAt > request.resource.data.startAt
          && (!('coverage' in request.resource.data) || request.resource.data.coverage is string)
          && request.resource.data.createdAt is timestamp
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
        allow update: if isOwner(userId) || isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(
            ['provider','policyNumber','startAt','endAt','coverage','updatedAt'])
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // bookings（トップレベル）
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false; // Cloud Functionsのみ（createBooking Callable）
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['confirmed','cancelled']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    // gachaClaims（1日1回/JST、createのみ可）
    match /users/{userId}/gachaClaims/{yyyymmdd} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['claimedAt','reward'])
        && request.resource.data.claimedAt is timestamp
        && (!('reward' in request.resource.data) || request.resource.data.reward is string);
      allow update, delete: if false;
    }

    // points（Cloud Functionsのみが書込可能）
    match /users/{userId}/points {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functionsのみ
    }

    // pointLedger（Cloud Functionsのみが書込可能）
    match /users/{userId}/pointLedger/{entryId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functionsのみ
    }

    // coupons（Cloud Functionsのみが書込可能）
    match /users/{userId}/coupons/{couponId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // redeemはCallableで処理
    }

    // serviceCenters（スロット管理、Cloud Functionsのみ書込）
    match /serviceCenters/{centerId}/days/{yyyymmdd}/slots/{slotId} {
      allow read: if isSignedIn(); // 全ログインユーザーが読取可能
      allow write: if false; // Cloud Functionsのみ
    }
  }
}
